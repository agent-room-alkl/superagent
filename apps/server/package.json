    "@fastify/static": "^8.0.0",
    "@superagent/shared": "0.1.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.1.0",
    "jose": "^5.10.0",
    "pg": "^8.13.0",
    "pgsql-ast-parser": "12.0.2",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
