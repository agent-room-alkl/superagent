# Local development only. Never commit real values.
APP_ROLE=web
PORT=8080
DATABASE_URL=postgres://superagent:superagent@localhost:5432/superagent
# Local dev auth: send header x-dev-user: "<userId>|<roles comma>|<projects comma>". Refused when NODE_ENV=production.
AUTH_MODE=dev
VITE_DEV_USER=dev-owner|owner|
PLATFORM_TENANT_ID=default
# Azure (production): managed identity + Key Vault; Entra token validation.
KEY_VAULT_URL=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
